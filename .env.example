# Copy to .env.local; configure the same variables in Vercel. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Session/transaction pooler connection from Supabase Connect.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_KEY
# Only confirmed Supabase accounts with these emails may open the private league.
ADMIN_EMAILS=imramaro@gmail.com
MEMBER_EMAILS=
